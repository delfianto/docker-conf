#!/usr/bin/env python3
"""Docker CLI plugin to list images grouped by registry and repository."""

import re
import sys
from collections import defaultdict

try:
    import cli_helper as cli
except ImportError:
    import os

    sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
    import cli_helper as cli

PLUGIN_METADATA = {
    "SchemaVersion": "0.1.0",
    "Vendor": "delfianto",
    "Version": "2.0.0",
    "ShortDescription": "List Docker images grouped by registry and repository",
}

# Additional color constants
BOLD = "\033[1m"
RESET = "\033[0m"

type TagList = list[tuple[str, str]]  # (tag, size)


def extract_registry(repo: str) -> str:
    """Extract the registry domain from a repository name."""
    # Has domain with dots (e.g., ghcr.io/user/repo or docker.io/library/nginx)
    if match := re.match(r"^([^/]+\.[^/]+)/", repo):
        return match.group(1)

    # Three-part without dots (e.g., registry/user/repo)
    if re.match(r"^([^/]+)/([^/]+)/.+$", repo):
        return repo.split("/")[0]

    # No domain = Docker Hub official (e.g., nginx, postgres)
    return "docker.io"


def get_images() -> tuple[dict[str, dict[str, TagList]], int]:
    """
    Group images as registry -> repository -> [(tag, size)].

    Returns the grouping and the number of dangling images.
    """
    result = cli.run_docker_command(
        ["image", "ls", "--format", "{{.Repository}}\t{{.Tag}}\t{{.Size}}"],
        check=True,
    )

    registries: dict[str, dict[str, TagList]] = defaultdict(lambda: defaultdict(list))
    dangling = 0

    for line in result.stdout.strip().split("\n"):
        if not line:
            continue

        repo, tag, size = line.split("\t")
        if "<none>" in (repo, tag):
            dangling += 1
            continue

        registry = extract_registry(repo)
        # The section header already names the registry; don't repeat it
        if repo.startswith(f"{registry}/"):
            repo = repo[len(registry) + 1 :]
        registries[registry][repo].append((tag, size))

    return registries, dangling


def main() -> int:
    """Main function to list images grouped by registry."""
    # Handle plugin metadata
    cli.handle_metadata(PLUGIN_METADATA)

    try:
        registries, dangling = get_images()

        if not registries and not dangling:
            print("No images found")
            return 0

        for registry in sorted(registries):
            repos = registries[registry]
            count = sum(len(tags) for tags in repos.values())
            plural = "s" if count != 1 else ""
            print(
                f"\n{BOLD}{cli.CYAN}{registry}{RESET} "
                f"{cli.BLUE}({count} image{plural}){cli.NC}"
            )

            width = max(len(repo) for repo in repos)
            for repo in sorted(repos):
                tags = " · ".join(
                    f"{cli.GREEN}{tag}{cli.NC} {cli.BLUE}({size}){cli.NC}"
                    for tag, size in sorted(repos[repo])
                )
                print(f"  {repo:<{width}}  {tags}")

        print()
        if dangling:
            plural = "s" if dangling != 1 else ""
            cli.print_warning(
                f"{dangling} dangling image{plural} taking up space "
                "(docker image prune)"
            )

        return 0

    except KeyboardInterrupt:
        cli.print_warning("\nInterrupted")
        return 130
    except Exception as e:
        cli.print_error(f"Error: {e}")
        return 1


if __name__ == "__main__":
    sys.exit(main())
