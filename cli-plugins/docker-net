#!/usr/bin/env python3
"""
Docker CLI plugin to bootstrap networks from config file
"""

import argparse
import json
import sys
from pathlib import Path

import tomllib

try:
    import cli_helper as cli
except ImportError:
    import os

    sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
    import cli_helper as cli

PLUGIN_METADATA = {
    "SchemaVersion": "0.1.0",
    "Vendor": "delfianto",
    "Version": "1.1.0",
    "ShortDescription": "Bootstrap or list Docker networks",
}


def list_networks():
    """List all Docker networks like 'docker network ls'"""
    result = cli.run_docker_command(["network", "ls"], check=False)
    if result.returncode == 0:
        print(result.stdout)
        return 0
    else:
        cli.print_error("Failed to list networks")
        print(f"  Error: {result.stderr.strip()}", file=sys.stderr)
        return 1


def create_network(name, config, dry_run=False):
    """Create a single Docker network"""
    cmd = ["network", "create"]
    cmd.extend(["--driver", config.get("driver", "bridge")])

    if config.get("internal", False):
        cmd.append("--internal")

    if "subnet" in config:
        cmd.extend(["--subnet", config["subnet"]])

    if "gateway" in config:
        cmd.extend(["--gateway", config["gateway"]])

    labels = config.get("labels", {})
    for key, value in labels.items():
        cmd.extend(["--label", f"{key}={value}"])

    cmd.append(name)

    if dry_run:
        print(f"[DRY RUN] Would execute: docker {' '.join(cmd)}")
        return True

    result = cli.run_docker_command(cmd, check=False)
    if result.returncode == 0:
        cli.print_success(f"✓ Created: {name}")
        return True
    elif "already exists" in result.stderr:
        cli.print_warning(f"⊘ Already exists: {name}")
        return True
    else:
        cli.print_error(f"✗ Failed: {name}")
        print(f"  Error: {result.stderr.strip()}", file=sys.stderr)
        return False


def bootstrap_networks(config_path, dry_run=False):
    """Bootstrap all networks from config file"""
    config_file = Path(config_path)
    if not config_file.exists():
        cli.print_error(f"Config file not found: {config_path}")
        return 1

    try:
        with open(config_file, "rb") as f:
            if config_file.suffix in [".toml"]:
                config = tomllib.load(f)
            else:
                cli.print_error(f"Unsupported file format: {config_file.suffix}")
                return 1
    except Exception as e:
        cli.print_error(f"Error parsing config file: {e}")
        return 1

    networks = config.get("networks", {})
    if not networks:
        cli.print_error("No networks defined in config")
        return 1

    if dry_run:
        print(f"[DRY RUN] Would bootstrap {len(networks)} network(s)...\n")
    else:
        print(f"Bootstrapping {len(networks)} network(s)...\n")

    success_count = 0
    for name, net_config in networks.items():
        if create_network(name, net_config, dry_run):
            success_count += 1

    print(f"\n{'=' * 50}")
    cli.print_info(f"Summary: {success_count}/{len(networks)} networks ready")
    print(f"{'=' * 50}\n")

    return 0 if success_count == len(networks) else 1


def inspect_network(name=None):
    """Fetch and format detailed network information"""
    cmd = ["network", "inspect"]

    if name:
        cmd.append(name)
    else:
        list_result = cli.run_docker_command(["network", "ls", "-q"], check=False)
        if list_result.returncode != 0:
            cli.print_error("Failed to retrieve network list")
            return 1
        cmd.extend(list_result.stdout.splitlines())

    result = cli.run_docker_command(cmd, check=False)
    if result.returncode != 0:
        cli.print_error("Failed to inspect network(s)")
        return 1

    try:
        networks = json.loads(result.stdout)
        for net in networks:
            # Main Section
            print(f"- Network: {net.get('Name')}")
            print(f"  ID: {net.get('Id')[:12]}")
            print(f"  Driver: {net.get('Driver')}")
            print(f"  Scope: {net.get('Scope')}")
            print(f"  Internal: {net.get('Internal')}")

            # IPAM (Subnet/Gateway) logic
            ipam_config = net.get("IPAM", {}).get("Config", [])
            if ipam_config:
                for cfg in ipam_config:
                    print(f"  Subnet: {cfg.get('Subnet', 'N/A')}")
                    print(f"  Gateway: {cfg.get('Gateway', 'N/A')}")
            else:
                print("  IPAM: None")

            # Container logic
            containers = net.get("Containers", {})
            if containers:
                print("  Containers:")
                for c_id, c_data in containers.items():
                    name = c_data.get("Name", "Unknown")
                    ip = c_data.get("IPv4Address", "No IP")
                    print(f"    - {name} ({ip})")
            else:
                print("  Containers: None")

            # Print Labels if they exist
            labels = net.get("Labels", {})
            if labels:
                print("  Labels:")
                for k, v in labels.items():
                    print(f"    {k}: {v}")

            print()
        return 0
    except json.JSONDecodeError:
        cli.print_error("Failed to parse Docker output as JSON")
        return 1


def main():
    cli.handle_metadata(PLUGIN_METADATA)

    parser = argparse.ArgumentParser(
        description="Bootstrap or list Docker networks",
        prog="docker net",
    )

    parser.add_argument(
        "-i",
        "--init",
        metavar="FILE",
        help="Bootstrap networks from a TOML configuration file",
    )

    parser.add_argument(
        "-v",
        "--view",
        metavar="NETWORK",
        nargs="?",
        const="ALL",
        help="Inspect a specific network or all networks if no name is provided",
    )

    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Show what would be created without actually creating",
    )

    args = cli.parse_plugin_args(parser, ["docker-net", "net"])

    if args.init:
        return bootstrap_networks(args.init, args.dry_run)

    if args.view:
        target = None if args.view == "ALL" else args.view
        return inspect_network(target)

    return list_networks()


if __name__ == "__main__":
    sys.exit(main())
